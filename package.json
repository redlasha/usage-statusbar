{
  "name": "@redlasha/usage-statusbar",
  "version": "1.8.0",
  "description": "Claude Code statusline for subscription users — account, model, session name, context window, 5-hour usage quota, reset timer, and prompt cache hit ratio",
  "main": "dist/index.cjs",
  "bin": {
    "usage-statusbar": "dist/index.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/index.cjs --setup"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "statusline",
    "usage",
    "context-window",
    "rate-limit",
    "multi-account",
    "claude-swap"
  ],
  "author": "redlasha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redlasha/usage-statusbar.git"
  },
  "homepage": "https://github.com/redlasha/usage-statusbar",
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25"
  }
}
